# Module 1 works without keys. Never commit .env.
# Module 2: choose an available FREE-TIER model in AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=
# Module 6: copy values from your own Meta developer app.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Choose a random private string, also entered in Meta's webhook configuration.
WHATSAPP_VERIFY_TOKEN=
# Your personal recipient number: country code + number, digits only (no +).
WHATSAPP_ALLOWED_SENDER=
# Copy the supported Graph API version shown in your Meta setup (vNN.0).
META_GRAPH_VERSION=
